# Aura Intimates — Environment Configuration Template
# Copy this file to .env or configure these variables in your hosting environment / Secrets panel.
# DO NOT commit real secrets or passwords to Git.

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="https://aura-intimates.ai.studio"

# ========================================================
# SMTP Email Configuration (For Owner OTP & Security Alerts)
# ========================================================
# For Gmail:
# - Host: smtp.gmail.com
# - Port: 587
# - User: Complete Gmail address (e.g. yourname@gmail.com)
# - Pass: Google App Password (16 characters generated from Google Account > Security > App Passwords)
# - Alert Email: The email address where OTP and security notifications should be delivered.
ALERT_EMAIL="owner@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="owner@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# ========================================================
# Optional Server-Side Owner Master Password Override
# ========================================================
# If set in production environment variables, allows the legitimate owner to sign in or recover access immediately.
# When used, the server automatically computes a fresh scrypt hash and salt for store.json.
# ADMIN_PASSWORD="your-strong-master-password"
# ADMIN_SETUP_SECRET="your-emergency-recovery-secret"
